# Model files are ignored by default
*.pth
*.pt
*.ckpt
local_models/

# Allow the compact final model and its metadata under model/ to be committed.
# Keep the much larger optimizer checkpoint ignored.
!model/
!model/**/
!model/**/best_model.pth
!model/**/best_model_info.json
!model/**/training_summary.json
model/**/latest_checkpoint.pth
