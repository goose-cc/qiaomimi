# =========================
# Python cache
# =========================
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class


# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/


# =========================
# IDE / editor
# =========================
.vscode/
.idea/


# =========================
# OS files
# =========================
.DS_Store
Thumbs.db


# =========================
# Temporary files
# =========================
*.tmp
*.log


# =========================
# Old single-sample dataset folders
# 旧版“一个样本一个 .npz 文件”的目录
# =========================
train/
val/
test/


# =========================
# Generated datasets
# =========================
percent10/
percent30/
*.npz


# =========================
# Model weights / checkpoints
# 本地保留，不上传新生成的权重
# 注意：已经被 Git 跟踪的权重不会因 .gitignore 自动删除
# =========================
model/
*.pth
*.pt
*.ckpt


# =========================
# Generated training results
# =========================
picture/training_results/
picture/sample_*.png
picture/*prediction*.png
picture/run_info.txt


# =========================
# Generated experiment figures
# =========================
picture/exp4_train/
picture/exp4_val/
picture/exp4_test_gamma05/
picture/exp4_test_gamma03/
figures_exp5/


# =========================
# Optional placeholder files
# 如需保留空目录，可提交 .gitkeep
# =========================
!picture/training_results/.gitkeep
